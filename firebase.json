{
  "hosting": {
    "target": "refugiowoof",
    "public": "WOOF_ADMIN",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "index.html",
        "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, private" }]
      },
      {
        "source": "dashboard.html",
        "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, private" }]
      }
    ]
  }
}
