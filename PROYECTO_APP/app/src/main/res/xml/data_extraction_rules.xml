<?xml version="1.0" encoding="utf-8"?>
<!--
    Reglas de extracción de datos para Android 12+.
    Se excluyen preferencias y caché para evitar que tokens, sesiones
    o datos sensibles sean transferidos vía cloud backup o device transfer.
    Referencia: https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Excluir SharedPreferences (puede contener tokens de sesión) -->
        <exclude domain="sharedpref" path="." />
        <!-- Excluir caché -->
        <exclude domain="cache" path="." />
        <exclude domain="external-cache" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Excluir SharedPreferences en transferencias entre dispositivos -->
        <exclude domain="sharedpref" path="." />
        <exclude domain="cache" path="." />
        <exclude domain="external-cache" path="." />
    </device-transfer>
</data-extraction-rules>
