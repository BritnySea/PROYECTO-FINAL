<?xml version="1.0" encoding="utf-8"?>
<!--
    Reglas de respaldo completo para Android 11 e inferior.
    Se excluyen las preferencias de la app y cualquier caché para evitar
    que tokens, sesiones o datos sensibles se incluyan en el backup.
    Referencia: https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- Excluir SharedPreferences de la app (puede contener tokens de sesión) -->
    <exclude domain="sharedpref" path="." />
    <!-- Excluir caché de imágenes y archivos temporales -->
    <exclude domain="cache" path="." />
    <exclude domain="external-cache" path="." />
</full-backup-content>
