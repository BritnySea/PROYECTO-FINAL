# ============================================================
# WOOF Backend — Variables de entorno
# Copia este archivo como .env y completa los valores reales.
# ============================================================

# Ruta al archivo JSON de credenciales de Firebase
# (Relativa al directorio raíz del backend)
FIREBASE_CREDENTIALS_PATH=firebase_credentials.json

# Ruta al modelo de IA
MODEL_PATH=ml/woof_model_v1.h5

# URL pública del modelo (opcional: si está vacío, el modelo debe estar en MODEL_PATH)
MODEL_DOWNLOAD_URL=

# Cloudinary — almacenamiento de imágenes
CLOUDINARY_CLOUD_NAME=REEMPLAZAR_CON_CLOUD_NAME
CLOUDINARY_API_KEY=REEMPLAZAR_CON_API_KEY
CLOUDINARY_API_SECRET=REEMPLAZAR_CON_API_SECRET

# Orígenes adicionales permitidos por CORS (separados por coma, opcional)
ALLOWED_ORIGINS=
