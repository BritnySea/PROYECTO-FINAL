# ══════════════════════════════════════════════════════
#  WOOF — Variables de entorno para pruebas automáticas
#  Copia este archivo como ".env.test" y completa los valores
# ══════════════════════════════════════════════════════

# URL del backend (local o Railway)
WOOF_API_URL=http://localhost:8000

# Firebase Web API Key (Firebase Console → Configuración del proyecto → General)
FIREBASE_API_KEY=AIzaSy_TU_CLAVE_AQUI

# Firebase Project ID (Firebase Console → Configuración del proyecto)
FIREBASE_PROJECT_ID=tu-proyecto-id

# Cuenta de usuario normal para pruebas (role="USER")
TEST_USER_EMAIL=usuario.prueba@gmail.com
TEST_USER_PASSWORD=ClaveUsuario123

# Cuenta de administrador para pruebas (role="ADMIN")
TEST_ADMIN_EMAIL=admin.prueba@gmail.com
TEST_ADMIN_PASSWORD=ClaveAdmin123

# Rutas a imágenes de prueba para el modelo IA
# Relativas a WOOF_TESTING/ o rutas absolutas
TEST_IMG_PERRO=fotos_prueba/perro.jpg
TEST_IMG_NODOG=fotos_prueba/gato.jpg
